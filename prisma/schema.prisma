// TeleBot Shop — data model
// Prisma + PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Users (Telegram customers)
// ------------------------------------------------------------------
model User {
  id           Int       @id @default(autoincrement())
  telegramId   BigInt    @unique
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?
  balance      Decimal   @default(0) @db.Decimal(12, 2) // store credit / wallet
  isBanned     Boolean   @default(false)
  isAdmin      Boolean   @default(false)
  totalSpent   Decimal   @default(0) @db.Decimal(12, 2)
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  orders  Order[]
  apiKeys ApiKey[]

  @@index([createdAt])
  @@index([isBanned])
}

// ------------------------------------------------------------------
// Categories (optional grouping in the shop)
// ------------------------------------------------------------------
model Category {
  id        Int       @id @default(autoincrement())
  name      String
  emoji     String    @default("📦")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  products Product[]
}

// ------------------------------------------------------------------
// Products
// ------------------------------------------------------------------
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  emoji       String   @default("🛍️")
  description String   @default("")
  price       Decimal  @db.Decimal(12, 2)
  // What this item costs the shop owner. Used for profit reporting only —
  // never shown to customers.
  cost        Decimal  @default(0) @db.Decimal(12, 2)
  categoryId  Int?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  // When true, delivery is pulled from StockItem inventory.
  // When false, product is "unlimited" and delivers a fixed template message.
  usesStock   Boolean  @default(true)
  // Delivered when usesStock = false (e.g. instructions), supports {order_id}
  fixedContent String  @default("")
  // Supplier-backed product: stock and price come from the supplier's API
  // (synced periodically) and each sale is bought from the supplier at
  // delivery time. All null for the shop's own products.
  supplierId        Int?
  supplierVariantId String?
  supplierPrice     Decimal? @db.Decimal(14, 2) // in the supplier's currency
  supplierStock     Int?
  supplierMinQty    Int?
  supplierMaxQty    Int?
  // Picked by the admin on the Supplier page. Only selected supplier
  // products appear on the Products page and can be sold.
  supplierSelected  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier  Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stock     StockItem[]
  orderItems OrderItem[]

  @@index([isActive])
  @@index([categoryId])
  @@index([supplierId])
}

// ------------------------------------------------------------------
// Upstream suppliers whose API we resell (live stock + auto-ordering)
// ------------------------------------------------------------------
model Supplier {
  id            Int       @id @default(autoincrement())
  name          String
  type          String    @default("tokopremium") // connector in src/suppliers/
  baseUrl       String
  apiKeyEnc     String    // AES-256-GCM encrypted; never returned by the admin API
  keyHint       String    @default("") // last 4 chars, to recognise the key
  currency      String    @default("IDR")
  // Supplier currency units per 1 unit of the shop currency (e.g. 16500 IDR = 1 USD).
  rate          Decimal   @default(1) @db.Decimal(14, 4)
  markupPct     Decimal   @default(20) @db.Decimal(7, 2)
  isActive      Boolean   @default(true)
  balance       Decimal?  @db.Decimal(16, 2) // last known balance at the supplier
  lastSyncAt    DateTime?
  lastSyncError String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products Product[]
}

// ------------------------------------------------------------------
// Stock items — the actual deliverable content (codes / accounts)
// ------------------------------------------------------------------
model StockItem {
  id          Int       @id @default(autoincrement())
  // Nullable so a product can be deleted without destroying the delivered
  // codes attached to past orders (SetNull instead of Cascade).
  productId   Int?
  content     String    // the secret delivered to the buyer
  isSold      Boolean   @default(false)
  soldAt      DateTime?
  orderItemId Int?
  createdAt   DateTime  @default(now())

  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId, isSold])
}

// ------------------------------------------------------------------
// Orders
// ------------------------------------------------------------------
enum OrderStatus {
  PENDING    // created, awaiting payment
  PAID       // payment confirmed
  DELIVERED  // goods handed to user
  CANCELLED  // user/admin cancelled
  EXPIRED    // timed out unpaid
  REFUNDED   // marked refunded by admin
  FAILED     // payment failed
}

enum PaymentMethod {
  CRYPTOMUS
  BINANCE // manual verification: customer pays the admin's Binance ID directly
  BYBIT // manual verification: customer pays the admin's Bybit UID directly
  BALANCE
}

model Order {
  id             Int           @id @default(autoincrement())
  publicId       String        @unique // short human code shown to user, e.g. ORD-8FK2QA
  userId         Int
  status         OrderStatus   @default(PENDING)
  method         PaymentMethod @default(CRYPTOMUS)
  kind           String        @default("PURCHASE") // PURCHASE | TOPUP (wallet credit)
  amount         Decimal       @db.Decimal(12, 2) // total in display currency
  currency       String        @default("USD")

  // Cryptomus linkage
  invoiceUuid    String?       // Cryptomus payment uuid
  invoiceOrderId String?       @unique // order_id we send to Cryptomus
  // Exchange transaction id (e.g. Binance Pay) matched to this order. Unique so
  // one incoming payment can never be used to settle two different orders.
  externalTxId   String?       @unique
  payUrl         String?       // hosted checkout url
  payCurrency    String?       // crypto the user actually paid in
  payAmount      String?       // crypto amount
  network        String?
  // Reseller-supplied order reference (API orders). Uniqueness is enforced by
  // ResellerOrderRef so a retried request can never buy twice.
  resellerRef    String?
  // Set when the order was placed through the reseller API with this key.
  apiKeyId       Int?

  paidAt         DateTime?
  deliveredAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey     ApiKey?     @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  events     OrderEvent[]

  @@index([apiKeyId])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  // Nullable: the line already snapshots name/emoji/price, so an order stays
  // fully readable after its product is deleted.
  productId  Int?
  productName String  // snapshot at purchase time
  emoji      String   @default("🛍️")
  unitPrice  Decimal  @db.Decimal(12, 2)
  // Cost snapshot at purchase time. Kept per-line so historical profit stays
  // accurate after the product's cost is later edited.
  unitCost   Decimal  @default(0) @db.Decimal(12, 2)
  quantity   Int
  lineTotal  Decimal  @db.Decimal(12, 2)

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  stock   StockItem[] // fulfilled stock (for usesStock products)

  @@index([orderId])
}

// Audit trail per order (great for the admin panel timeline)
model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  type      String   // created | invoice_created | payment_received | delivered | expired | cancelled | note
  message   String   @default("")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ------------------------------------------------------------------
// Key/value settings editable from the admin panel
// ------------------------------------------------------------------
model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------------
// Admin panel accounts
// ------------------------------------------------------------------
model AdminAccount {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("owner") // owner | staff
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
}

// ------------------------------------------------------------------
// Reseller API keys — let other sellers pull the catalog + live stock
// into their own stores. Only a SHA-256 hash of the key is stored.
// ------------------------------------------------------------------
model ApiKey {
  id         Int       @id @default(autoincrement())
  name       String    // who this key belongs to, e.g. "Rahim's store"
  keyPrefix  String    // first chars of the key, shown in the panel to identify it
  keyHash    String    @unique
  isActive   Boolean   @default(true)
  // Reseller's Telegram account. API orders are paid from this user's wallet
  // balance and appear in their order history. Null = catalog/stock only.
  userId     Int?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders Order[]
}

// Idempotency lock for reseller API orders: the reference is claimed here
// (primary key) before any money moves, so concurrent retries can't double-buy.
// A separate table rather than a unique index on Order, because adding a
// unique index to an existing table makes `prisma db push` refuse at boot.
model ResellerOrderRef {
  userId    Int
  reference String
  orderId   Int?      // set once the order exists
  createdAt DateTime  @default(now())

  @@id([userId, reference])
}

// ------------------------------------------------------------------
// Telegram channel posts (daily stock, new products, manual posts).
// dedupeKey is claimed BEFORE sending, so automatic posts can never go out
// twice — not after a restart, not with two instances running.
// ------------------------------------------------------------------
model ChannelPost {
  id         Int       @id @default(autoincrement())
  kind       String    // daily_stock | new_product | product | price_update | sold_out | custom | test
  dedupeKey  String?   @unique // e.g. "daily:2026-11-08", "new:42"; null for manual posts
  productId  Int?
  chatId     String
  messageIds String    @default("") // comma-separated Telegram message ids
  status     String    @default("pending") // pending | sent | failed | skipped | unknown | deleted
  error      String?
  preview    String    @default("")
  createdBy  String    @default("auto")
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([kind, createdAt])
  @@index([productId])
}

// ------------------------------------------------------------------
// Broadcast log
// ------------------------------------------------------------------
model Broadcast {
  id         Int      @id @default(autoincrement())
  text       String
  sentCount  Int      @default(0)
  failCount  Int      @default(0)
  createdAt  DateTime @default(now())
}

// ------------------------------------------------------------------
// Wallet credit requests (user asks admin for store credit)
// ------------------------------------------------------------------
model CreditRequest {
  id         Int      @id @default(autoincrement())
  userId     Int
  telegramId BigInt
  username   String?
  amount     Decimal  @db.Decimal(12, 2)
  note       String   @default("")
  status     String   @default("PENDING") // PENDING | APPROVED | DECLINED
  createdAt  DateTime @default(now())

  @@index([status])
}
